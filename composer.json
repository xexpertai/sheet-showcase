{
    "name": "xexpertai/sheet-showcase",
    "description": "Turn an Excel or CSV sheet into a clean, searchable, mobile-friendly web page. No database, no build step.",
    "type": "project",
    "license": "MIT",
    "keywords": ["excel", "xlsx", "csv", "catalog", "directory", "static-site"],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": { "SheetShowcase\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "SheetShowcase\\Tests\\": "tests/php/", "SheetShowcase\\Tools\\": "tools/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
